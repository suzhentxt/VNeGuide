{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vneguide.local/schemas/rule-context-catalog-v1.json",
  "title": "VNeGuide Rule Context Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "procedure_code",
      "input_id",
      "label",
      "type",
      "origin",
      "source_ids"
    ],
    "properties": {
      "procedure_code": {
        "enum": ["2.000635", "1.013314", "1.004194"]
      },
      "input_id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "label": {
        "type": "string"
      },
      "type": {
        "enum": ["string", "boolean", "enum"]
      },
      "origin": {
        "enum": ["intent_extraction", "document_check", "user_declaration", "derived"]
      },
      "values": {
        "type": "array"
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
