# URL server-side để Next.js BFF gọi VNeGuide Chat API.
# Không thêm NEXT_PUBLIC_ và không đặt API key model trong file này.
VNEGUIDE_API_BASE_URL=http://127.0.0.1:8000

# STT server-side: trình duyệt gửi audio tới Next.js BFF, không gọi GPU provider trực tiếp.
# Không dùng NEXT_PUBLIC_* và không ghi API key vào file này trong production.
VNEGUIDE_STT_ENABLED=0
VNEGUIDE_STT_BASE_URL=https://stt.example.invalid/v1
VNEGUIDE_STT_MODEL=Qwen/Qwen3-ASR-1.7B
VNEGUIDE_STT_LANGUAGE=
VNEGUIDE_STT_PROMPT=
VNEGUIDE_STT_API_KEY_FILE=
VNEGUIDE_STT_ALLOW_INSECURE_HTTP=0
VNEGUIDE_STT_TIMEOUT_SECONDS=180
VNEGUIDE_STT_MAX_BYTES=10485760
VNEGUIDE_STT_MAX_DURATION_SECONDS=60
