# URL server-side để Next.js BFF gọi VNeGuide Chat API.
# Không thêm NEXT_PUBLIC_ và không đặt API key model trong file này.
VNEGUIDE_API_BASE_URL=http://127.0.0.1:8000
VNEGUIDE_OCR_BASE_URL=http://127.0.0.1:8010
VNEGUIDE_OCR_WORKER_TOKEN=replace-with-a-random-local-token

# STT server-side: trình duyệt gửi audio tới Next.js BFF, không gọi GPU provider trực tiếp.
# Không dùng NEXT_PUBLIC_* và không ghi API key vào file này trong production.
VNEGUIDE_STT_ENABLED=0
VNEGUIDE_STT_BASE_URL=https://stt.example.invalid/v1
VNEGUIDE_STT_MODEL=Qwen/Qwen3-ASR-1.7B
VNEGUIDE_STT_LANGUAGE=
VNEGUIDE_STT_PROMPT=
VNEGUIDE_STT_API_KEY_FILE=
VNEGUIDE_STT_ALLOW_INSECURE_HTTP=0
VNEGUIDE_STT_TIMEOUT_SECONDS=180
VNEGUIDE_STT_MAX_BYTES=10485760
VNEGUIDE_STT_MAX_DURATION_SECONDS=60
# Có gửi tham số language cho provider không? Mặc định bật (OpenAI chấp nhận).
# Tắt cho các endpoint vLLM/Qwen ASR cục bộ có thể từ chối tham số không nhận diện.
VNEGUIDE_STT_SEND_LANGUAGE=1
# Chuyển audio sang WAV 16kHz mono PCM trước khi gửi provider.
# Bật cho ASR cục bộ (Qwen3-ASR) chỉ chấp nhận WAV; tắt cho OpenAI.
VNEGUIDE_STT_CONVERT_TO_WAV=0

# TTS server-side: browser chỉ gửi vị trí tin nhắn assistant tới BFF; không gọi provider trực tiếp.
# TTS mặc định tắt. Key đọc theo thứ tự: VNEGUIDE_TTS_API_KEY_FILE (file, cho production)
# rồi tới VNEGUIDE_TTS_API_KEY / VNEGUIDE_API_KEY (env trực tiếp, cho dev dùng chung key OpenAI).
# Không đặt key vào biến NEXT_PUBLIC_*.
VNEGUIDE_TTS_ENABLED=0
VNEGUIDE_TTS_BASE_URL=https://api.openai.com/v1
VNEGUIDE_TTS_MODEL=gpt-4o-mini-tts
VNEGUIDE_TTS_VOICE=marin
VNEGUIDE_TTS_INSTRUCTIONS=Nói tiếng Việt tự nhiên, rõ ràng, với nhịp độ vừa phải. Giữ nguyên tên riêng, mã thủ tục và số liệu.
VNEGUIDE_TTS_FORMAT=mp3
VNEGUIDE_TTS_SPEED=1
VNEGUIDE_TTS_API_KEY_FILE=
VNEGUIDE_TTS_ALLOW_INSECURE_HTTP=0
VNEGUIDE_TTS_TIMEOUT_SECONDS=60
VNEGUIDE_TTS_MAX_MESSAGE_CHARACTERS=4000
VNEGUIDE_TTS_SEGMENT_CHARACTERS=600
VNEGUIDE_TTS_MAX_RESPONSE_BYTES=8388608
