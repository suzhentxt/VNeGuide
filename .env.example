# Sao chép thành .env hoặc export thủ công. Không commit API key thật.
VNEGUIDE_LLM_PROVIDER=mock
VNEGUIDE_MODEL=
VNEGUIDE_API_KEY=

# Factory tạo session tích hợp CLI với core, định dạng package.module:callable.
VNEGUIDE_SESSION_FACTORY=vneguide.core:create_session

# Chỉ bật khi chủ động chạy smoke test với provider thật.
VNEGUIDE_RUN_LIVE_SMOKE=0

# HTTP API phục vụ chatbox web. Giữ host local khi chạy demo trên cùng máy.
VNEGUIDE_API_HOST=127.0.0.1
VNEGUIDE_API_PORT=8000
VNEGUIDE_SESSION_TTL_SECONDS=1800
VNEGUIDE_SESSION_MAX_ACTIVE=100

