# Sao chép thành .env. Baseline mặc định dùng mock và không cần API key.
# Đổi provider thành litellm và model thành model đã deploy khi chủ động dùng gateway thật.
VNEGUIDE_LLM_PROVIDER=mock
VNEGUIDE_MODEL=mock-scripted
VNEGUIDE_LITELLM_BASE_URL=https://litellm.example.invalid
VNEGUIDE_LITELLM_API_KEY=
# HTTP chỉ dùng cho môi trường dev tin cậy và dữ liệu giả; production phải dùng HTTPS.
VNEGUIDE_LITELLM_ALLOW_INSECURE_HTTP=0
VNEGUIDE_LITELLM_DISABLE_THINKING=1

# Dev-only: log mỗi LLM call (input + output + latency) ra file JSONL.
# File chứa raw prompt (có thể có PII) — chỉ dùng local, không commit.
VNEGUIDE_LLM_LOG=0
VNEGUIDE_LLM_LOG_PATH=logs/llm_calls.jsonl

# Chỉ dùng cho provider openai chính thức.
VNEGUIDE_API_KEY=

# Factory tạo session tích hợp CLI với core, định dạng package.module:callable.
VNEGUIDE_SESSION_FACTORY=vneguide.core:create_session

# Chỉ bật khi chủ động chạy smoke test với provider thật.
VNEGUIDE_RUN_LIVE_SMOKE=0

# HTTP API phục vụ chatbox web. Giữ host local khi chạy demo trên cùng máy.
VNEGUIDE_API_HOST=127.0.0.1
VNEGUIDE_API_PORT=8000
VNEGUIDE_SESSION_TTL_SECONDS=1800
VNEGUIDE_SESSION_MAX_ACTIVE=100

# OCR CT01 mặc định tắt. Worker đọc các biến OCR từ process environment;
# tùy chọn --env-file của worker chỉ nạp cấu hình LLM.
VNEGUIDE_OCR_ENABLED=0
VNEGUIDE_OCR_WORKER_TOKEN=
VNEGUIDE_OCR_MAX_QUEUED_JOBS=2
VNEGUIDE_OCR_JOB_TIMEOUT_SECONDS=300
VNEGUIDE_OCR_RESULT_TTL_SECONDS=600

# Speech-to-text (STT) chạy ở GPU service riêng; Next.js chỉ làm BFF/proxy cùng origin.
# Mặc định tắt để STT/provider từ xa không ảnh hưởng health hoặc luồng chat hiện có.
# Production chỉ chấp nhận HTTPS. Chỉ bật HTTP cho endpoint dev trên mạng tin cậy.
VNEGUIDE_STT_ENABLED=0
VNEGUIDE_STT_BASE_URL=https://stt.example.invalid/v1
VNEGUIDE_STT_MODEL=Qwen/Qwen3-ASR-1.7B
VNEGUIDE_STT_API_KEY_FILE=
VNEGUIDE_STT_ALLOW_INSECURE_HTTP=0
VNEGUIDE_STT_TIMEOUT_SECONDS=180
VNEGUIDE_STT_MAX_BYTES=10485760
VNEGUIDE_STT_MAX_DURATION_SECONDS=60

# Port host cho Docker Compose release stack.
VNEGUIDE_WEB_PORT=3000
VNEGUIDE_GATEWAY_PORT=8080
